      "kind": "fs.replace_exact",
      "capability": "fs.write",
      "target": {
        "path": "abyss_cli/evolution_analysis.py"
      },
      "input": {
        "old_content": "def _extract_json_fenced_blocks(text: str, start_re: re.Pattern[str]) -> list[str]:\n    blocks: list[str] = []\n    for start in start_re.finditer(text):\n        content_start = start.end()\n        for fence in FENCE_RE.finditer(text, content_start):\n            block = text[content_start:fence.start()].strip()\n            if not block:\n                continue\n            try:\n                json.loads(block)\n            except json.JSONDecodeError:\n                repaired = re.sub(r\",\\s*([}\\]])\", r\"\\1\", block)\n                try:\n                    json.loads(repaired)\n                except json.JSONDecodeError:\n                    continue\n            blocks.append(block)\n            break\n    return blocks\n",
        "new_content": "def _extract_json_fenced_blocks(text: str, block_names: str | tuple[str, ...]) -> list[str]:\n    return extract_named_json_blocks(text, block_names)\n"
      },
      "preconditions": [
        "old_content_matches_once"
      ],
      "rollback": {
        "strategy": "manual_revert_from_git_diff"
      }
    },

      },
      "input": {
        "old_content": "    matches = _extract_json_fenced_blocks(text, EVOLUTION_ANALYSIS_BLOCK_START_RE)\n",
        "new_content": "    matches = _extract_json_fenced_blocks(text, \"abyss-evolution-analysis\")\n"
      },

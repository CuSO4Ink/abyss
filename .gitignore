# Local machine state
.local/

# Personal knowledge and archive data
user_data/*
!user_data/README.md
!user_data/.gitkeep
storage/*
!storage/README.md
!storage/.gitkeep
!storage/archive/
storage/archive/*
!storage/archive/README.md
!storage/archive/.gitkeep

# Secrets and credentials
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*secret*
*secrets*
*token*
*credential*
*credentials*

# Runtime/cache
.cache/
.tmp/
tmp/
temp/
__pycache__/
*.pyc
*.egg-info/

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

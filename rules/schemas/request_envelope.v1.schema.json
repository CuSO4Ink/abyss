{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abyss.request_envelope.v1",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "request_type",
    "source",
    "created_at",
    "created_by",
    "title",
    "description",
    "status",
    "governance_route",
    "requires_code_change",
    "requires_cognition_update",
    "requires_owner_approval",
    "required_context",
    "expected_artifacts",
    "validation_plan"
  ],
  "properties": {
    "schema": {"const": "abyss.request_envelope.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "display_key": {"type": "string"},
    "request_type": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "user_intent": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"type": "string"},
    "governance_route": {"type": "string", "minLength": 1},
    "requires_code_change": {"type": "boolean"},
    "requires_cognition_update": {"type": "boolean"},
    "requires_owner_approval": {"type": "boolean"},
    "required_context": {"type": "array", "items": {"type": "string"}},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "validation_plan": {"type": "array", "items": {"type": "string"}},
    "related_documents": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["draft", "normalized", "needs_clarification", "accepted", "rejected", "superseded"]},
    "request_fields": {"type": "object"},
    "missing_required_fields": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "contract_version": {"type": "string"}
  }
}
